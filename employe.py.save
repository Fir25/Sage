
import pandas as pd
import psycopg2

# File path for your Excel file
file_path = '/home/srv-pointage/projet/Classeur3.xlsx'

# PostgreSQL connection details
conn = psycopg2.connect(
    dbname='ipstime',
    user='root',
    password='root',
    host='192.168.1.113',
    port='5432'
)

cur = conn.cursor()

lissst = []

# Load Excel file without headers if they are not present
data = pd.read_excel(file_path, header=None)

# Function to handle NULL values for clean display
def handle_null(value):
    return None if pd.isna(value) or value == '' else value

# Function to convert active status to boolean
def convert_to_boolean(value):
    return value in ['si', 'yes', True, 1]

# Function to handle integer conversion and manage invalid text
def handle_integer(value):
    try:
        # Vérifie d'abord si la valeur est numérique
        return int(value) if str(value).isdigit() else None
    except (ValueError, TypeError):
        return None

# Loop over each row in the DataFrame
for index, row in data.iterrows():
    is_active = convert_to_boolean(handle_null(row[0]))
    matricule = handle_null(row[1])
    last_name = handle_null(row[2])
    intitule_etablissement = handle_null(row[4])
    role_id = handle_null(row[5])
    ligne_de_production = handle_null(row[7])
    superviseur = handle_null(row[8])
    poste = handle_null(row[9])
    type_de_travail = handle_null(row[10])
    categorie_sage_fc = handle_null(row[11])
    fonction_fiche_de_paie = handle_null(row[12])
    nbre_jours_restants_echeance = handle_integer(row[15])  # Handle integer conversion
    motifparti = handle_null(row[17])
    type_depart = handle_null(row[18])
    type_contrat = handle_null(row[19])
    statut = handle_null(row[20])
    premier_contrat_sage_tunisia = handle_null(row[25])
    mois_embauche = handle_null(row[26])
    annee_embauche = handle_integer(row[27])
    tranche_anciennete = handle_null(row[30])
    tranche_age = handle_null(row[33])
    cnss = handle_null(row[34])
    cle_cnss = handle_null(row[35])
    CIN = handle_null(row[36])
    sex = handle_null(row[38]) or 'M'
    situation_social = handle_null(row[39])
    nbenfants = handle_null(row[40])
    niveau_scolaire = handle_null(row[41])
    categorie = handle_null(row[42])
    echelon = handle_null(row[43])
    prochaine_date_echelon = handle_null(row[44])
    type_salaire = handle_null(row[45])
    cout_h = handle_null(row[46])
    rib_banquaire = handle_null(row[47])
    banque = handle_null(row[48])
    rib_virement = handle_null(row[49])
    verif_nbr_rib = convert_to_boolean(handle_null(row[50]))
    adresse = handle_null(row[51])
    commune = handle_null(row[52])
    code_postale = handle_null(row[53])
    visite_medicale = convert_to_boolean(handle_null(row[54]))
    telephone_contact_fam = handle_null(row[56])
    bien_de_la_societe = handle_null(row[57])
    destination = handle_null(row[58])
    departement_bulletin = handle_null(row[59])

    # Print the details for each row for debugging purposes
    print(f"Row {index}:")
    print(f"  Is Active: {is_active}")
    print(f"  Personnel ID: {matricule}")
    print(f"  Name: {last_name}")
    print(f"  Function: {role_id}")
    print("-" * 30)

    # Prepare the UPDATE statement based on 'matricule'
    update_query = """
    UPDATE syspointage_newuser
    SET 
        intitule_etablissement = %s,  ligne_de_production = %s, superviseur = %s, 
        poste = %s, type_de_travail = %s, categorie_sage_fc = %s, fonction_fiche_de_paie = %s, 
        nbre_jours_restants_echeance = %s, motifparti = %s, type_depart = %s, type_contrat = %s, 
        statut = %s, premier_contrat_sage_tunisia = %s, mois_embauche = %s, annee_embauche = %s, 
        tranche_anciennete = %s, tranche_age = %s, cnss = %s, cle_cnss = %s, CIN = %s, sex = %s, 
        situation_social = %s, nbenfants = %s, niveau_scolaire = %s, categorie = %s, echelon = %s, 
        prochaine_date_echelon = %s, type_salaire = %s, cout_h = %s, rib_banquaire = %s, banque = %s, 
        rib_virement = %s, verif_nbr_rib = %s, adresse = %s, commune = %s, code_postale = %s, 
        visite_medicale = %s, telephone_contact_fam = %s, bien_de_la_societe = %s, destination = %s, 
        departement_bulletin = %s
    WHERE matricule = %s;
    """

    # Execute the update statement
    cur.execute(update_query, (
        intitule_etablissement,  ligne_de_production, superviseur, poste, type_de_travail,
        categorie_sage_fc, fonction_fiche_de_paie, nbre_jours_restants_echeance, motifparti,
        type_depart, type_contrat, statut, premier_contrat_sage_tunisia, mois_embauche, annee_embauche,
        tranche_anciennete, tranche_age, cnss, cle_cnss, CIN, sex, situation_social, nbenfants,
        niveau_scolaire, categorie, echelon, prochaine_date_echelon, type_salaire, cout_h,
        rib_banquaire, banque, rib_virement, verif_nbr_rib, adresse, commune, code_postale,
        visite_medicale, telephone_contact_fam, bien_de_la_societe, destination, departement_bulletin,
        matricule
    ))

    # Commit the changes to the database
    conn.commit()

# Close the connection
cur.close()
conn.close()

# Print the list of unhandled functions
for fonction in set(lissst):
    print(fonction)

